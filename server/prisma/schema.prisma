generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tables managed by Better Auth. Field names follow its core schema.
model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Local part of the receipt forwarding address ({alias}@<RECEIPT_EMAIL_DOMAIN>).
  // Random and unguessable; created on first use.
  forwardingAlias String?   @unique
  sessions        Session[]
  accounts        Account[]
  items           Item[]
  receipts        Receipt[]
  outfits         Outfit[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// One row per sign-in method; for e-mail sign-in it holds the password hash.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

// Short-lived tokens, e.g. for password resets.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- Wardrobe data. Every row belongs to one user and is removed with them. ---

enum Season {
  fruehling
  sommer
  herbst
  winter
  ganzjaehrig
}

enum Visibility {
  PRIVATE
  LINK
  PUBLIC
}

enum LifecycleStatus {
  ACTIVE
  SORTED_OUT
  SOLD
  GIVEN_AWAY
}

enum ReceiptSource {
  UPLOAD
  EMAIL
}

enum ParseStatus {
  PENDING
  PARSED
  FAILED
  MANUAL
}

model Item {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String
  color        String?
  brand        String?
  size         String?
  price        Decimal?  @db.Decimal(10, 2)
  currency     String    @default("EUR")
  purchaseDate DateTime? @db.Date
  material     String?
  retailer     String?
  productUrl   String?
  seasons      Season[]
  notes        String?
  // Object keys in the "item-photos" bucket: {userId}/{itemId}/{filename}
  photoKey     String?
  thumbnailKey String?
  receiptId    String?
  receipt      Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  // Not used by any feature yet; nothing is readable by others, whatever these say.
  visibility      Visibility      @default(PRIVATE)
  isForSale       Boolean         @default(false)
  isTradeable     Boolean         @default(false)
  isLinkable      Boolean         @default(false)
  lifecycleStatus LifecycleStatus @default(ACTIVE)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  outfitItems OutfitItem[]

  @@index([userId])
  @@index([userId, category])
  @@index([userId, brand])
  @@index([receiptId])
  @@map("item")
}

model Receipt {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Object key in the "receipts" bucket: {userId}/{receiptId}/{filename}
  fileKey      String
  source       ReceiptSource
  merchant     String?
  purchaseDate DateTime?     @db.Date
  receivedAt   DateTime      @default(now())
  parseStatus  ParseStatus   @default(PENDING)
  createdAt    DateTime      @default(now())
  items        Item[]

  @@index([userId])
  @@map("receipt")
}

model Outfit {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  occasion  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  items     OutfitItem[]

  @@index([userId])
  @@map("outfit")
}

// Placement of one item on an outfit canvas. Owned through its outfit.
model OutfitItem {
  outfitId String
  outfit   Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // Position of the item on the canvas, relative to its size: 0 to 1.
  x        Float
  y        Float
  scale    Float  @default(1)
  zIndex   Int    @default(0)

  @@id([outfitId, itemId])
  @@index([itemId])
  @@map("outfit_item")
}
