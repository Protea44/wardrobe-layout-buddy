# Only needed for a real mail server; Mailpit takes mail without login.
# SMTP_USER=
# SMTP_PASSWORD=
# Copy to .env and replace every "change-me". .env is gitignored.
# docker compose and the backend both read this file.

# --- Backend ---
# NODE_ENV is deliberately not set here: Vite reads this file too and would then
# ship a development build. Set NODE_ENV=production in the production environment.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Set to true only behind a reverse proxy that sets X-Forwarded-* headers.
TRUST_PROXY=false
# Requests per minute and client, across all routes.
RATE_LIMIT_MAX=300
# Stricter limit for sign-in, sign-up and password reset requests.
AUTH_RATE_LIMIT_MAX=20
# Maximum request body size in bytes.
BODY_LIMIT_BYTES=1048576
# Built frontend served in production. Defaults to <repo>/dist.
# FRONTEND_DIR=

# --- Authentication ---
# Public origin of the app, exactly as typed in the browser. Sign-in only works from
# this origin, and links in e-mails point to it. Locally this is the Vite dev server.
APP_URL=http://localhost:5173
# Signs session cookies. At least 32 random characters, e.g. from: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me

# --- PostgreSQL ---
POSTGRES_USER=kleiderschrank
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kleiderschrank
POSTGRES_PORT=5432
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://kleiderschrank:change-me@127.0.0.1:5432/kleiderschrank
# Used by the backend tests only; must be a different database than DATABASE_URL.
TEST_DATABASE_URL=postgresql://kleiderschrank:change-me@127.0.0.1:5432/kleiderschrank_test

# --- Object storage (SeaweedFS locally, an EU S3 provider in production) ---
S3_PORT=9000
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=eu-central-1
# Locally docker compose starts the storage service with these credentials.
S3_ACCESS_KEY_ID=kleiderschrank
S3_SECRET_ACCESS_KEY=change-me
# true for SeaweedFS; most hosted providers work with false.
S3_FORCE_PATH_STYLE=true
S3_BUCKET_ITEM_PHOTOS=item-photos
S3_BUCKET_RECEIPTS=receipts

# --- Receipt forwarding (inbound e-mail) ---
# Forwarding addresses are {alias}@RECEIPT_EMAIL_DOMAIN. Must match src/config/receipts.ts.
RECEIPT_EMAIL_DOMAIN=belege.kleiderschrank-kompakt.de
# Shared secret the mail provider sends in the x-inbound-secret header, at least
# 32 characters, e.g. from: openssl rand -hex 32. Unset: inbound mail is refused.
INBOUND_SECRET=change-me-to-at-least-32-random-characters
# Inbound requests per minute and client.
INBOUND_RATE_LIMIT_MAX=30

# --- E-mail (Mailpit locally, web UI on http://127.0.0.1:8025) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM=Kleiderschrank Kompakt <no-reply@localhost>